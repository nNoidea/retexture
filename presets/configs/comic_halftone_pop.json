{
  "size": [
    256,
    256
  ],
  "resize_filter": "nearest",
  "export_format": "png",
  "jpg_quality": 90,
  "palette_mode": "preset_palette",
  "palette_preset": "halftone_comic_16",
  "color_metric": "oklab",
  "max_colors": 16,
  "custom_palette_colors": null,
  "dither_algorithm": "halftone_dot",
  "dither_strength": 0.85,
  "dither_scale": 1,
  "linear_color_space": true,
  "alpha_stipple": true,
  "grain": 0.0,
  "grain_seed": 42,
  "grain_monochrome": true,
  "hue": 0.0,
  "saturation": 1.3,
  "brightness": 1.0,
  "contrast": 1.2,
  "color_temperature": 0.0,
  "midtones": 0.0,
  "highlights": 0.0,
  "luminance_threshold": 0.5,
  "invert_luminance": false,
  "pre_blur": 0.0,
  "chromatic_aberration": 0.0,
  "crt_scanlines": 0.0,
  "grime_decay": 0.0,
  "edge_crunch": 0.0,
  "outline_strength": 0.25,
  "bilateral_simplify": 0.0,
  "pixeloe_strength": 0.0,
  "cel_shading_steps": 0,
  "seamless_tiling": false,
  "seam_size": 0.2,
  "seamless_wrap": true,
  "name": "Comic Halftone Pop Art",
  "description": "Pop art comic book look at 256x256. Halftone dot dithering with high saturation. Outlines complete the printed-comic-page aesthetic.",
  "base_preset": "comic_halftone_pop"
}